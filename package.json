    "@angular/platform-browser": "^21.2.0",
    "@fontsource/noto-serif": "^5.3.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.9.3"
